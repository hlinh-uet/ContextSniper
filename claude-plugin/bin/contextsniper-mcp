#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$PLUGIN_ROOT/.." && pwd)"
AUTO_START="${CONTEXTSNIPER_PLUGIN_AUTO_START:-1}"
AUTO_STOP="${CONTEXTSNIPER_PLUGIN_AUTO_STOP:-1}"

# Let local shell startup provide keys/base URLs on developer machines. Keep this
# quiet because MCP stdio must reserve stdout for JSON-RPC.
if [ -f "$HOME/.bashrc" ]; then
  # shellcheck disable=SC1090
  source "$HOME/.bashrc" >/dev/null 2>&1 || true
fi

pick_python() {
  local candidate
  for candidate in \
    "${PY_BIN:-}" \
    "$REPO_ROOT/.venv/bin/python" \
    "$REPO_ROOT/.venv/bin/python3" \
    "$HOME/miniconda3/bin/python" \
    "$HOME/anaconda3/bin/python" \
    "$HOME/mambaforge/bin/python" \
    "$HOME/miniforge3/bin/python" \
    "$(command -v python3 2>/dev/null || true)" \
    "$(command -v python 2>/dev/null || true)"
  do
    [ -n "$candidate" ] || continue
    [ -x "$candidate" ] || continue
    if "$candidate" - <<'PY' >/dev/null 2>&1
import flask
import mcp
import openai
import pyagfs
PY
    then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

PYTHON_BIN="$(pick_python)" || {
  echo "contextsniper MCP could not find a Python interpreter with the required runtime packages installed." >&2
  echo "Install dependencies with: python3 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt" >&2
  echo "Or set PY_BIN=/path/to/python before launching Claude." >&2
  exit 1
}

export PY_BIN="${PY_BIN:-$PYTHON_BIN}"
export PYTHONPATH="$PLUGIN_ROOT:$REPO_ROOT/code-version:$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export CONTEXTSNIPER_URL="${CONTEXTSNIPER_URL:-http://127.0.0.1:8090}"
export CONTEXTSNIPER_CODE_TOGGLE="${CONTEXTSNIPER_CODE_TOGGLE:-true}"
export NO_PROXY="127.0.0.1,localhost,::1${NO_PROXY:+,${NO_PROXY}}"
export no_proxy="$NO_PROXY"

export CONTEXTSNIPER_PLUGIN_AUTO_START="$AUTO_START"
export CONTEXTSNIPER_PLUGIN_AUTO_STOP="$AUTO_STOP"
exec "$PYTHON_BIN" -m contextsniper_mcp
