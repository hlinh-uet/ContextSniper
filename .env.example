# Copy this file to .env, then add credentials for your own account:
#   cp .env.example .env
# Never commit or share a .env file containing real keys.

# Required for ContextSniper semantic retrieval and for DeepSeek repair runs.
OPENROUTER_API_KEY="sk-or-v1-..."

# Optional: only needed for OpenHands + GPT when using --openhands-auth api-key.
# OPENAI_API_KEY="sk-..."

# Shared plain-ContextSniper embedding configuration.
CONTEXTSNIPER_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
CONTEXTSNIPER_EMBEDDING_MODEL=openai/text-embedding-3-small
